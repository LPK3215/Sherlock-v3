# ============================================================================
# AI Dialog Bot — Environment Configuration
# ============================================================================
# This project only supports the Cascade pipeline (STT + VLM + TTS).
# ============================================================================
AI_MODE=cascade

# ============================================================================
# Cascade Mode — 3 independent stages, each with swappable providers
# ============================================================================
# Set AI_MODE=cascade, then pick a provider for each stage below.

# ---- STT: whisper | funasr | moonshine | openai ----
CASCADE_STT_PROVIDER=whisper

# -- whisper (local, free) --
#   model: tiny | base | small | medium | large-v3
#   device: auto | cpu | cuda
CASCADE_STT_WHISPER_MODEL=tiny
CASCADE_STT_WHISPER_DEVICE=cpu
CASCADE_STT_WHISPER_COMPUTE_TYPE=int8

# -- funasr (local, free, best Chinese accuracy) --
CASCADE_STT_FUNASR_DEVICE=cpu

# -- moonshine (local, free, ultra-lightweight CPU) --
#   (no config needed)

# -- openai (API) --
CASCADE_STT_OPENAI_API_KEY=
CASCADE_STT_OPENAI_BASE_URL=
CASCADE_STT_OPENAI_MODEL=whisper-1

# ---- VLM: minicpm | openai ----
CASCADE_VLM_PROVIDER=openai

# -- minicpm (OpenAI-compatible) --
CASCADE_VLM_MINICPM_API_KEY=
CASCADE_VLM_MINICPM_BASE_URL=https://api.modelbest.cn/v1
CASCADE_VLM_MINICPM_MODEL=MiniCPM-O-4.5-9B

# -- openai (needs API key) --
CASCADE_VLM_OPENAI_API_KEY=
CASCADE_VLM_OPENAI_BASE_URL=
CASCADE_VLM_OPENAI_MODEL=

# ---- TTS: kokoro | piper | openai ----
CASCADE_TTS_PROVIDER=piper

# -- kokoro (local, free) --
#   English voices: af_sky, af_bella, am_adam, am_michael
CASCADE_TTS_KOKORO_VOICE=af_sky

# -- piper (local, free) --
CASCADE_TTS_PIPER_VOICE=zh_CN-huayan-medium

# -- openai (API) --
CASCADE_TTS_OPENAI_API_KEY=
CASCADE_TTS_OPENAI_BASE_URL=
CASCADE_TTS_OPENAI_MODEL=tts-1
CASCADE_TTS_OPENAI_VOICE=alloy
