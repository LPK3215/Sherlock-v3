# Sherlock Cascade server configuration
# Copy this file to .env, then fill in only the VLM connection values.

AI_MODE=cascade

# Local speech-to-text
CASCADE_STT_PROVIDER=whisper
CASCADE_STT_WHISPER_MODEL=tiny
CASCADE_STT_WHISPER_DEVICE=cpu
CASCADE_STT_WHISPER_COMPUTE_TYPE=int8

# OpenAI-compatible vision language model (required)
CASCADE_VLM_PROVIDER=openai
CASCADE_VLM_OPENAI_API_KEY=
CASCADE_VLM_OPENAI_BASE_URL=
CASCADE_VLM_OPENAI_MODEL=

# Local Chinese text-to-speech
CASCADE_TTS_PROVIDER=piper
CASCADE_TTS_PIPER_VOICE=zh_CN-huayan-medium
