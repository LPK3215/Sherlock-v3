# ============================================================
#  my-projects 统一环境变量配置
#  合并来源: my-video-ai + ai-video-call-core
#  复制此文件为 .env 并填入你的 API Keys
# ============================================================

# 注意：此文件不供 web-bot-official 使用。
# web-bot-official 只读取 web-bot-official/server/.env。

# -------------------- 运行模式 --------------------
# realtime = 直连模式 (Gemini Live / OpenAI Realtime)
# cascade  = 级联模式 (STT → LLM → TTS)
AI_MODE=cascade
AI_PROVIDER=openai
AI_LANGUAGE=zh-CN

# -------------------- Google --------------------
# 适用于: Gemini Live 直连 + Gemini 级联
GOOGLE_API_KEY=

# Google Cloud STT/TTS（仅级联模式需要）
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CLOUD_LOCATION=global

# -------------------- OpenAI --------------------
# 适用于: OpenAI Realtime 直连 + OpenAI 级联
OPENAI_API_KEY=

# -------------------- 模型/语音覆盖（留空使用默认值） --------------------
# --- Gemini Live ---
GEMINI_LIVE_MODEL=
GEMINI_LIVE_VOICE=Charon

# --- OpenAI Realtime ---
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_TRANSCRIPTION_MODEL=
OPENAI_VIDEO_FRAME_DETAIL=auto

# --- 级联: STT ---
OPENAI_STT_MODEL=
GOOGLE_STT_MODEL=latest_long

# --- 级联: LLM ---
OPENAI_LLM_MODEL=
GOOGLE_LLM_MODEL=

# --- 级联: TTS ---
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=alloy
GOOGLE_TTS_MODEL=
GOOGLE_TTS_LANGUAGE=cmn-CN
GOOGLE_TTS_VOICE=cmn-CN-Chirp3-HD-Charon

# -------------------- 前端 --------------------
# 两个项目端口不同，按需修改
# my-video-ai 后端:     http://localhost:7861/start
# ai-video-call-core 后端: http://localhost:7871/start
VITE_BOT_START_URL=http://localhost:7861/start
