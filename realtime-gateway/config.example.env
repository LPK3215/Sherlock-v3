# Sherlock realtime gateway configuration
# Yuxi owns the Agent, prompt, tools, skills, memory and conversation state.

AI_MODE=cascade
AGENT_RUNTIME=yuxi
YUXI_BASE_URL=http://localhost:5050

# Optional local defaults. The realtime client normally supplies these per session.
YUXI_ACCESS_TOKEN=
YUXI_AGENT_SLUG=
YUXI_THREAD_ID=

# Local speech-to-text
CASCADE_STT_PROVIDER=whisper
CASCADE_STT_WHISPER_MODEL=tiny
CASCADE_STT_WHISPER_DEVICE=cpu
CASCADE_STT_WHISPER_COMPUTE_TYPE=int8

# Standalone fallback only. Ignored when AGENT_RUNTIME=yuxi.
CASCADE_VLM_PROVIDER=openai
CASCADE_VLM_OPENAI_API_KEY=
CASCADE_VLM_OPENAI_BASE_URL=
CASCADE_VLM_OPENAI_MODEL=

# Local Chinese text-to-speech
CASCADE_TTS_PROVIDER=piper
CASCADE_TTS_PIPER_VOICE=zh_CN-huayan-medium
